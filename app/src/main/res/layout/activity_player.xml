<?xml version="1.0" encoding="utf-8"?>
<!-- 資訊列放在播放器下方，不疊在播放器上（YouTube API 條款不允許遮擋播放器） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:descendantFocusability="blocksDescendants"
        android:focusable="false"
        app:enableAutomaticInitialization="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#14213D"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- 觸控裝置（手機、平板）才顯示，電視維持遙控器操作 -->
        <LinearLayout
            android:id="@+id/touchControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/backButton"
                style="@style/TouchControl"
                android:text="@string/step_back" />

            <Button
                android:id="@+id/playButton"
                style="@style/TouchControl" />

            <Button
                android:id="@+id/forwardButton"
                style="@style/TouchControl"
                android:text="@string/step_forward" />

            <Button
                android:id="@+id/stepButton"
                style="@style/TouchControl" />

            <Button
                android:id="@+id/rateButton"
                style="@style/TouchControl" />
        </LinearLayout>

        <TextView
            android:id="@+id/helpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help"
            android:textColor="#99FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
